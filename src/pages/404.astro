---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="section dark layers" style="min-height:60vh;display:grid;place-items:center">
    <div class="container center">
      <span class="eyebrow">Error 404</span>
      <h1>This part didn’t print.</h1>
      <p class="lead">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="hero-ctas" style="justify-content:center"><a class="btn btn-primary btn-lg" href="/">Back to home</a><a class="btn btn-ghost-light btn-lg" href="/quote/">Start a request</a></div>
    </div>
  </section>
</Base>
