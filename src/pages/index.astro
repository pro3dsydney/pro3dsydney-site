---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Sketch from '../components/art/Sketch.astro';
import Cad from '../components/art/Cad.astro';
import Part from '../components/art/Part.astro';
import Estimator from '../components/Estimator.astro';
import { business } from '../config';

const services = [
  { icon: 'pencil', t: '3D modelling from sketches', d: 'No CAD file? Send a sketch, photo or measurements and we’ll model it for you.', href: '/3d-design/' },
  { icon: 'wrench', t: 'Replacement & repair parts', d: 'Broken clip, knob or bracket? We measure it, recreate it, and often make it stronger than the original.', href: '/3d-design/' },
  { icon: 'cube', t: 'Prototypes', d: 'Fast iterations for product ideas, enclosures and fit checks, with honest advice on design for printing.', href: '/quote/' },
  { icon: 'layers', t: 'Small-batch production', d: 'Jigs, fixtures and short runs from 5 to 500 units, with consistent quality and quantity pricing.', href: '/pricing/' },
  { icon: 'ruler', t: 'Precision & fine detail', d: 'Layer heights down to 0.06 mm with a 0.2 mm nozzle for miniatures, text and tight tolerances.', href: '/materials/' },
  { icon: 'shield', t: 'Engineering materials', d: 'PETG, ASA, TPU, polycarbonate and carbon-fibre blends for parts that have to survive real use.', href: '/materials/' },
];
---
<Base
  title="3D Printing & 3D Modelling in Sydney | Ultimate3D Sydney"
  description="Sydney 3D printing studio in Coogee. Send a 3D file, photo or sketch: we design it, print it in PLA, PETG, ASA, TPU or carbon fibre, with a typical 24–48 h turnaround. Instant online quotes."
>
  <!-- Hero: three slides that cycle slowly -->
  <section class="hero dark layers" aria-roledescription="carousel" aria-label="Highlights">
    <div class="container">
      <div class="hero-slides" id="heroSlides">
        <!-- 1: premium FDM -->
        <div class="hero-slide active hero-grid" data-slide="0" role="group" aria-roledescription="slide" aria-label="1 of 3">
          <div>
            <span class="eyebrow">3D printing &amp; design · Coogee, Sydney</span>
            <h1>Premium FDM printing with <span class="hl">0.06&nbsp;mm</span> layers.</h1>
            <p class="lead">Since {business.since}, Ultimate3D has helped Sydney makers, startups and engineers turn CAD into production-ready parts. Expert design-for-print feedback and consistent results, <b style="color:#fff">fast</b>.</p>
            <div class="hero-ctas">
              <a class="btn btn-primary btn-lg" href="/quote/" data-track="cta_click" data-label="hero1_quote">Get a same-day quote <span class="arrow">→</span></a>
              <a class="btn btn-ghost-light btn-lg" href="/instant-quote/" data-track="cta_click" data-label="hero1_instant">Have a file? Instant price</a>
            </div>
          </div>
          <div class="hero-visual">
            <div class="hero-frame">
              <video id="heroVideo" muted loop playsinline preload="none" poster="/media/printing-poster.jpg" aria-label="Time-lapse of a part printing in our studio">
                <source src="/media/printing.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="hero-badge b1"><span class="dot" style="background:#e8efff;color:#2563eb"><Icon name="layers" /></span><span><b>0.06 mm</b>finest layer height</span></div>
          </div>
        </div>

        <!-- 2: sketch to part -->
        <div class="hero-slide hero-grid" data-slide="1" role="group" aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true">
          <div>
            <span class="eyebrow">No 3D file? No problem</span>
            <p class="hero-title">From a sketch on a napkin to a <span class="hl">part in your hand.</span></p>
            <p class="lead">Send us a photo, a rough drawing with measurements, or the broken part. We model it in CAD, show you a preview, and print it in the right material.</p>
            <div class="hero-ctas">
              <a class="btn btn-primary btn-lg" href="/quote/" data-track="cta_click" data-label="hero2_sketch" tabindex="-1">Send a sketch or photo <span class="arrow">→</span></a>
              <a class="btn btn-ghost-light btn-lg" href="/3d-design/" data-track="cta_click" data-label="hero2_design" tabindex="-1">How 3D design works</a>
            </div>
          </div>
          <div class="hero-visual">
            <div class="hero-frame hero-art duo"><Sketch /><span class="arrow-big" aria-hidden="true">→</span><Part /></div>
            <div class="hero-badge b1"><span class="dot" style="background:#fff3e8;color:#ea580c"><Icon name="pencil" /></span><span><b>We design it</b>from your sketch</span></div>
          </div>
        </div>

        <!-- 3: can it be made? -->
        <div class="hero-slide hero-grid" data-slide="2" role="group" aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true">
          <div>
            <span class="eyebrow">Free printability check</span>
            <p class="hero-title">Not sure if your part can be made? <span class="hl">We’ll let you know today.</span></p>
            <p class="lead">Send it over and a real person checks it: strength, wall thickness, tolerances, the best material and orientation. Free, with no obligation.</p>
            <div class="hero-ctas">
              <a class="btn btn-primary btn-lg" href="/quote/" data-track="cta_click" data-label="hero3_check" tabindex="-1">Check my part <span class="arrow">→</span></a>
              <a class="btn btn-ghost-light btn-lg" href="/faq/" data-track="cta_click" data-label="hero3_faq" tabindex="-1">Common questions</a>
            </div>
          </div>
          <div class="hero-visual">
            <div class="hero-frame hero-art"><div class="check-card"><Cad />
              <div class="check-list">
                <span class="chip ok">✓ Walls 1.6 mm, strong enough</span>
                <span class="chip ok">✓ Fits in one piece</span>
                <span class="chip warn">! Hole: print 0.2 mm larger</span>
                <span class="chip ok">✓ Best in PETG</span>
              </div>
            </div></div>
            <div class="hero-badge b1"><span class="dot" style="background:#e7f8f1;color:#059669"><Icon name="check" /></span><span><b>Same-day</b>printability check</span></div>
          </div>
        </div>
      </div>

      <ul class="hero-stats" aria-label="Key facts">
        <li><b>{business.clients} clients</b><span>Individuals &amp; businesses</span></li>
        <li><b>{business.turnaround}</b><span>Typical turnaround</span></li>
        <li><a href={business.google.profileUrl} target="_blank" rel="noopener" style="color:inherit;text-decoration:none"><b><span class="stars" style="font-size:.95rem">★★★★★</span> {business.google.rating.toFixed(1)}</b><span>On Google</span></a></li>
      </ul>
      <div class="hero-controls">
        <div class="hero-dots" id="heroDots" role="tablist" aria-label="Choose slide">
          <button type="button" role="tab" aria-label="Slide 1: premium FDM printing" aria-current="true"></button>
          <button type="button" role="tab" aria-label="Slide 2: from a sketch to a part"></button>
          <button type="button" role="tab" aria-label="Slide 3: free printability check"></button>
        </div>
        <button type="button" class="hero-pause" id="heroPause" aria-label="Pause slideshow">❚❚</button>
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="proof" aria-label="About us">
    <div class="container">
      <div class="proof-item"><b>{business.since}</b><span>Printing in Sydney since</span></div>
      <div class="proof-item"><b>0.06 mm</b><span>Finest layer height</span></div>
      <div class="proof-item"><b>6</b><span>Engineering materials in stock</span></div>
      <div class="proof-item"><b>Same day</b><span>Printability check, usually</span></div>
    </div>
  </section>

  <!-- Filament brands -->
  <section class="marquee" aria-label="Filament brands we print with">
    <div class="marquee-label">Premium filament from</div>
    <div class="marquee-track">
      {[0, 1].map(dup => (
        <>
          <img src="/img/brands/bambu-lab.webp" alt={dup ? '' : 'Bambu Lab'} aria-hidden={dup ? 'true' : undefined} style="--h:44px" width="142" height="96" />
          <img src="/img/brands/polymaker.webp" alt={dup ? '' : 'Polymaker'} aria-hidden={dup ? 'true' : undefined} style="--h:44px" width="171" height="96" />
          <img src="/img/brands/esun.webp" alt={dup ? '' : 'eSUN'} aria-hidden={dup ? 'true' : undefined} style="--h:30px" width="393" height="96" />
          <img src="/img/brands/colorfabb.webp" alt={dup ? '' : 'colorFabb'} aria-hidden={dup ? 'true' : undefined} style="--h:44px" width="164" height="96" />
          <img src="/img/brands/sunlu.webp" alt={dup ? '' : 'Sunlu'} aria-hidden={dup ? 'true' : undefined} style="--h:26px" width="420" height="96" />
          <img src="/img/brands/bambu-lab.webp" alt="" aria-hidden="true" style="--h:44px" width="142" height="96" />
          <img src="/img/brands/polymaker.webp" alt="" aria-hidden="true" style="--h:44px" width="171" height="96" />
          <img src="/img/brands/esun.webp" alt="" aria-hidden="true" style="--h:30px" width="393" height="96" />
          <img src="/img/brands/colorfabb.webp" alt="" aria-hidden="true" style="--h:44px" width="164" height="96" />
          <img src="/img/brands/sunlu.webp" alt="" aria-hidden="true" style="--h:26px" width="420" height="96" />
        </>
      ))}
    </div>
  </section>

  <!-- Two paths -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Two ways to get it made</span>
        <h2>Let us handle it, or take full control.</h2>
        <p class="lead">Most people start with a request and we do the thinking. Makers with print-ready files can configure and pay online in two minutes.</p>
      </div>
      <div class="paths">
        <article class="path featured reveal">
          <span class="tag">Most popular · Design &amp; print</span>
          <h3>Send us anything. We’ll handle the rest.</h3>
          <p>A 3D file, a photo of a broken part, a sketch on paper, or just an idea. We turn it into a printable model, pick the right material, and quote you.</p>
          <ul>
            <li><Icon name="check" size={18} />Upload 3D files, photos, sketches or PDFs</li>
            <li><Icon name="check" size={18} />We do the 3D modelling if you don’t have a file</li>
            <li><Icon name="check" size={18} />Advice on strength, material and finish</li>
            <li><Icon name="check" size={18} />Quote by email within one business day</li>
          </ul>
          <a class="btn btn-primary btn-lg" href="/quote/" data-track="path_chosen" data-label="home_request">Start a request <span class="arrow">→</span></a>
          <p class="fine">No account. No payment until you approve the quote.</p>
        </article>
        <article class="path reveal">
          <span class="tag">For makers · Instant quote</span>
          <h3>Print-ready file? Price it in seconds.</h3>
          <p>Upload STL, 3MF or STEP and choose your own settings, just like your slicer. Our real slicing engine prices it from actual material and print time.</p>
          <ul>
            <li><Icon name="check" size={18} />0.2 mm or 0.4 mm nozzle, layer heights 0.06–0.24 mm</li>
            <li><Icon name="check" size={18} />Infill, walls, supports, material and colour</li>
            <li><Icon name="check" size={18} />3D preview with size and printability checks</li>
            <li><Icon name="check" size={18} />Card only charged after we’ve checked your file</li>
          </ul>
          <a class="btn btn-lg" href="/instant-quote/" data-track="path_chosen" data-label="home_instant">Get an instant price <span class="arrow">→</span></a>
          <p class="fine">If your file can’t be printed, the hold is released. You pay nothing.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Ballpark estimator -->
  <section class="section soft" id="estimate">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ballpark estimator</span>
        <h2>Roughly how much will it cost?</h2>
        <p class="lead">Slide to your part’s size for a quick, non-binding estimate. For an exact price, upload the file.</p>
      </div>
      <Estimator />
    </div>
  </section>

  <!-- Sketch to part -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">No CAD? No problem</span>
        <h2>We design parts from sketches, photos and broken pieces.</h2>
        <p class="lead">You don’t need to know 3D modelling. Give us measurements, even rough ones, and we’ll model it properly, send you a preview, then print it.</p>
      </div>
      <div class="journey">
        <figure class="reveal"><div class="art"><Sketch /></div><figcaption><span class="step-n">01 · You send</span><b>A sketch, photo or old part</b><span class="muted">Phone photos next to a ruler work great. Add rough measurements if you can.</span></figcaption></figure>
        <figure class="reveal"><div class="art"><Cad /></div><figcaption><span class="step-n">02 · We model</span><b>A precise 3D model</b><span class="muted">Designed in CAD with real tolerances. We send you a preview before printing.</span></figcaption></figure>
        <figure class="reveal"><div class="art"><Part /></div><figcaption><span class="step-n">03 · You get</span><b>A finished, functional part</b><span class="muted">Printed in the right material for the job. Pick it up in Coogee or we’ll ship it.</span></figcaption></figure>
      </div>
      <p style="margin-top:28px"><a class="btn" href="/3d-design/">How our 3D design service works <span class="arrow">→</span></a></p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Recent work</span>
        <h2>From prototypes to finished pieces.</h2>
      </div>
      <div class="gallery">
        <figure class="reveal"><img src="/img/gearbox.webp" alt="Multi-stage 3D-printed gearbox with printed gears, shafts and bearing housings" loading="lazy" width="1200" height="900" /><figcaption>Functional gearbox</figcaption></figure>
        <figure class="reveal"><img src="/img/temple.jpg" alt="Detailed architectural temple model printed at fine layer height" loading="lazy" width="516" height="516" /><figcaption>Architectural model</figcaption></figure>
        <figure class="reveal"><img src="/img/vase.webp" alt="Decorative spiral vase printed in silk PLA" loading="lazy" width="850" height="500" /><figcaption>Decor &amp; gifts</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we make</span>
        <h2>One studio for design, prototyping and production.</h2>
      </div>
      <div class="grid-3">
        {services.map(s => (
          <a class="card reveal" href={s.href} style="text-decoration:none;color:inherit">
            <div class="ico"><Icon name={s.icon} size={22} /></div>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section dark layers">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Four steps. Usually done within three days.</h2>
      </div>
      <ol class="steps" style="padding:0;margin:0">
        <li><h3>Send it over</h3><p>Upload files, photos or a description. Takes about two minutes and no account is needed.</p></li>
        <li><h3>We check &amp; quote</h3><p>A real person reviews printability, suggests improvements and confirms the price.</p></li>
        <li><h3>Print &amp; inspect</h3><p>Printed on calibrated, high-precision machines, then cleaned up and quality-checked.</p></li>
        <li><h3>Pickup or delivery</h3><p>Collect in Coogee, Sydney courier, or Australia Post Express nationwide.</p></li>
      </ol>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Reviews</span><h2>Trusted by Sydney makers and teams.</h2></div>
      <Reviews />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section soft">
    <div class="container">
      <div class="section-head center"><span class="eyebrow">Questions</span><h2>Good to know</h2></div>
      <Faq ids={['no-file', 'two-ways', 'charged', 'cost', 'turnaround']} />
      <p class="center" style="margin-top:24px"><a href="/faq/">All questions →</a></p>
    </div>
  </section>

  <CtaBand />
  <script>
    // Hero slideshow
    const SLIDE_MS = 8000;
    const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('#heroDots button')];
    const dotsWrap = document.getElementById('heroDots')!;
    const pauseBtn = document.getElementById('heroPause')!;
    const hero = document.querySelector<HTMLElement>('.hero')!;
    const video = document.getElementById('heroVideo') as HTMLVideoElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData;
    hero.style.setProperty('--slide-ms', SLIDE_MS + 'ms');
    let i = 0, timer = 0, userPaused = reduce, hoverPaused = false, heroVisible = true;

    function show(n: number) {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === i;
        s.classList.toggle('active', on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll<HTMLElement>('a, button').forEach(el => on ? el.removeAttribute('tabindex') : el.setAttribute('tabindex', '-1'));
      });
      dots.forEach((d, k) => {
        d.removeAttribute('aria-current'); d.classList.toggle('done', false);
        void d.offsetWidth; // restart the progress animation
        if (k === i) d.setAttribute('aria-current', 'true');
      });
      syncVideo();
      schedule();
    }
    function running() { return !userPaused && !hoverPaused && heroVisible && document.visibilityState === 'visible'; }
    function schedule() {
      clearTimeout(timer);
      dotsWrap.classList.toggle('paused', !running());
      if (running()) timer = window.setTimeout(() => show(i + 1), SLIDE_MS);
    }
    function syncVideo() {
      if (!video || reduce || saveData) return;
      if (i === 0 && heroVisible) video.play().catch(() => {}); else video.pause();
    }

    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.textContent = userPaused ? '▶' : '❚❚';
      pauseBtn.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
      schedule();
    });
    if (reduce) { pauseBtn.textContent = '▶'; pauseBtn.setAttribute('aria-label', 'Play slideshow'); }
    const slideBox = document.getElementById('heroSlides')!;
    slideBox.addEventListener('mouseenter', () => { hoverPaused = true; schedule(); });
    slideBox.addEventListener('mouseleave', () => { hoverPaused = false; schedule(); });
    slideBox.addEventListener('focusin', () => { hoverPaused = true; schedule(); });
    slideBox.addEventListener('focusout', () => { hoverPaused = false; schedule(); });
    document.addEventListener('visibilitychange', schedule);
    // Swipe on phones
    let x0: number | null = null;
    slideBox.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
    slideBox.addEventListener('touchend', e => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1));
    });
    new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; syncVideo(); schedule(); }, { threshold: 0.2 }).observe(hero);
    show(0);
  </script>
</Base>
